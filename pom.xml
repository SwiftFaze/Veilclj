<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.swiftfaze</groupId>
    <artifactId>Veil</artifactId>
    <version>0.5.0-beta.29</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cucumber.version>7.34.6</cucumber.version>
        <main.class>com.swiftfaze.veil.Main</main.class>
        <!-- Default for exec-maven-plugin's own `exec.mainClass` parameter (see the
             plugin config below) - a plain `mvn compile exec:java` with no `-D` override
             runs the game; `-Dexec.mainClass=...` on the command line overrides this
             property, e.g. to launch the sandbox instead. -->
        <exec.mainClass>${main.class}</exec.mainClass>
        <!-- Whether a PMD violation fails the build. True everywhere by default,
             including CI. `.claude/tools/check-clean.sh` overrides it to false so
             the build runs to completion and it can diff-scope target/pmd.xml
             itself, reporting the violations YOUR change added with file:line
             instead of inheriting a repo-wide count. This has to be a property:
             a plain `-Dpmd.failOnViolation=false` is ignored when the value is
             set literally in the plugin's <configuration>. -->
        <pmd.failOnViolation>true</pmd.failOnViolation>
        <!-- maven-pmd-plugin 3.28.0 manages PMD 7.17.0 by default. Bumped to the
             latest stable PMD release for #215's full-catalogue audit: 18 of the
             199 native rules the audit found only exist from PMD 7.2x onward.
             See docs/clean-code-gate.md for the 4 rules that remain unavailable
             (not yet in any stable PMD release as of this bump). -->
        <pmd.version>7.27.0</pmd.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.14.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JSpecify nullability annotations (@Nullable, @NullMarked) - issue #216 -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Module dependency gate (Constraints in .claude/workflow.md): ModuleDependencyTest
             enforces the engine/widgets/screens layering docs/architecture.md documents. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Acceptance tests (Step 5): runs .feature files from /specs/features via RunCucumberTest -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Property-based testing with jqwik (issue #200) -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>1.10.1</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <!-- JSON Schema validation for the mod-loading contract (issue #201) -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>3.0.7</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.18</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Declaring <resources> at all overrides Maven's implicit default
                 (src/main/resources) rather than adding to it, so that default
                 must be listed explicitly or logback.xml and everything else in
                 it silently stop being copied to target/classes. -->
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <!-- JSON schemas for mod content types, committed under docs/schemas/ and loaded
                 at runtime by ModSchemaValidator for field-level validation and diagnostics -->
            <resource>
                <directory>${project.basedir}/docs/schemas</directory>
                <targetPath>schemas</targetPath>
            </resource>
        </resources>
        <testResources>
            <!-- .feature files live in /specs/features (single source of truth per the
                 intent -> spec pipeline), copied onto the test classpath so Cucumber's
                 @SelectPackages("features") can discover them. -->
            <testResource>
                <directory>${project.basedir}/specs/features</directory>
                <targetPath>features</targetPath>
            </testResource>
            <!-- JSON schemas for testing ModSchemaValidator and validating mod files -->
            <testResource>
                <directory>${project.basedir}/docs/schemas</directory>
                <targetPath>schemas</targetPath>
            </testResource>
            <!-- ArchUnit configuration and freeze store for the module dependency gate -->
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <!-- Step 4 compile-time gates: Error Prone (default check set, repo-wide) and NullAway
                 (scoped via @NullMarked package-info.java files, JSpecify mode - see below). Both run at
                 javac compile time (not a verify-bound analysis phase), failing the build on violations.
                 Error Prone catches: @Override on non-overrides, enum switch exhaustiveness, format
                 mismatches, mutable statics, reference-equality on boxed types. NullAway enforces
                 non-null-by-default on every @NullMarked package (see docs/testing-quality-gates.md for
                 full rationale and how to extend coverage). This machine runs Maven on JDK 24, newer than
                 the project's JDK 17 compile target, which is OK — the jdk.compiler internal packages
                 these flags reach into have been stable since JDK 9. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <fork>true</fork>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <!-- Required by Error Prone whenever the JDK actually running javac is 16+
                             (confirmed error message: "-XDaddTypeAnnotationsToSymbol=true is required
                             by Error Prone on JDK 21"). This repo's CI runs JDK 17 for both Maven and
                             the forked javac, where this is mandatory; a dev machine running Maven on
                             a newer host JDK while cross-compiling to an older target can silently not
                             need it, which is exactly how this got missed until CI caught it. -->
                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                        <!-- Everything ErrorProne/NullAway needs MUST stay on this single line, no
                             XML line-wrapping. maven-compiler-plugin forks javac via a generated
                             Windows batch file when <fork>true</fork> + -J flags are present, and on
                             Windows that batch-file generation silently rewrites backslash line-
                             continuations inside a multi-line <arg> into forward slashes, corrupting
                             the flag list (confirmed bug: google/error-prone#4256). This machine is
                             Windows, so this is not theoretical - keep this whole string as one <arg>
                             with no embedded newlines.
                             Demoted checks: EnumOrdinal (fixed tab indices), StringCaseLocaleUsage (ASCII content types), MissingSummary (style-only), ImmutableEnumChecker (function field records) -->
                        <arg>-Xplugin:ErrorProne -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true -Xep:NullAway:ERROR -Xep:EnumOrdinal:ERROR -Xep:StringCaseLocaleUsage:ERROR -Xep:MissingSummary:ERROR -Xep:ImmutableEnumChecker:ERROR</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=java.base/jdk.internal.javac=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=java.base/java.math=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=java.base/java.nio=ALL-UNNAMED</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>2.50.0</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>0.13.8</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Unit + acceptance tests (*Test.java, including the Cucumber suite runner) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
            <!-- Integration tests (*IT.java) only, bound to integration-test/verify -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.5</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Produces target/veil-<version>-app.jar, a single runnable jar with all
                 dependencies bundled, which the Windows installer build (docs/release.md)
                 feeds into jpackage. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>app</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                            <!-- Dependency manifests and multi-release module-info
                                 variants aren't needed in the fat jar (the
                                 ManifestResourceTransformer above supplies the real
                                 one); excluding them stops shade's harmless-but-noisy
                                 overlapping-resource warnings for these entries. -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Lets `mvn compile exec:java` run the game directly from
                 compiled classes, no packaging or version needed. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
            <!-- Step 6 (mutation testing): `mvn org.pitest:pitest-maven:mutationCoverage`.
                 Targets the domain/logic classes that have real unit tests; Swing view
                 classes with no meaningful unit coverage (Main, panels that are pure
                 layout/styling, ClassSandbox's own entry point) are excluded rather than left
                 to report a wall of untested surviving mutants. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.17.4</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- Mutation testing is the check on the unit tests, which are not
                         human-reviewed (.claude/workflow.md Step 6). Anything with unit
                         tests but no PIT target is therefore unchecked: line coverage
                         alone is satisfiable with assertion-free tests, which is exactly
                         what happened to ui/game/config under the 85% JaCoCo gate. Keep
                         this list in step with the classes that have real logic; the
                         pure layout/wiring classes are excluded below instead. -->
                    <targetClasses>
                        <param>com.swiftfaze.veil.Camera</param>
                        <param>com.swiftfaze.veil.world.*</param>
                        <param>com.swiftfaze.veil.testing.approval.*</param>
                        <param>com.swiftfaze.veil.entities.*</param>
                        <param>com.swiftfaze.veil.mods.*</param>
                        <param>com.swiftfaze.veil.ui.*</param>
                        <param>com.swiftfaze.veil.game.*</param>
                        <param>com.swiftfaze.veil.config.*</param>
                        <param>com.swiftfaze.veil.input.Keybindings</param>
                        <param>com.swiftfaze.veil.sandbox.ClassSandboxModel</param>
                        <param>com.swiftfaze.veil.sandbox.ClassSandboxPanel</param>
                        <param>com.swiftfaze.veil.sandbox.DevConsoleModel</param>
                        <param>com.swiftfaze.veil.sandbox.DevConsolePanel</param>
                        <param>com.swiftfaze.veil.sandbox.ClassSandboxProvider</param>
                        <param>com.swiftfaze.veil.sandbox.ClassDetailPanel</param>
                        <param>com.swiftfaze.veil.sandbox.DevConsoleCommandRunner</param>
                        <param>com.swiftfaze.veil.sandbox.PlayerSandboxProvider</param>
                        <param>com.swiftfaze.veil.sandbox.PlayerDetailPanel</param>
                        <param>com.swiftfaze.veil.sandbox.PlayerField</param>
                        <param>com.swiftfaze.veil.sandbox.PlayerFieldMutator</param>
                        <param>com.swiftfaze.veil.sandbox.DevConsoleCompletion</param>
                        <param>com.swiftfaze.veil.sandbox.DevConsoleCommandHistory</param>
                        <param>com.swiftfaze.veil.ui.widget.SuggestionOverlayWidget</param>
                    </targetClasses>
                    <!-- Same pure layout/wiring classes the PMD and JaCoCo exclusion
                         lists below carry, for the same reason: no branching logic to
                         mutate, so they would only report a wall of untested mutants.
                         InventoryPanel is deliberately NOT here — JaCoCo excludes it but
                         it has real logic and a PIT target predating this list. -->
                    <excludedClasses>
                        <param>com.swiftfaze.veil.ui.widget.ButtonWidget</param>
                        <param>com.swiftfaze.veil.ui.widget.FocusManager</param>
                        <param>com.swiftfaze.veil.ui.widget.TerminalScrollBarUI</param>
                        <param>com.swiftfaze.veil.ui.widget.Widget</param>
                        <param>com.swiftfaze.veil.ui.GameWindow</param>
                        <param>com.swiftfaze.veil.ui.ResetConfirmationPopup</param>
                        <param>com.swiftfaze.veil.ui.SettingsWindow</param>
                        <param>com.swiftfaze.veil.game.GameListener</param>
                    </excludedClasses>
                    <targetTests>
                        <param>com.swiftfaze.veil.*</param>
                    </targetTests>
                    <!-- Widening targetClasses above multiplied the mutant count, and
                         every mutant re-runs the matching tests - which for this repo
                         includes Cucumber scenarios, the slowest tests here. Single-
                         threaded (PIT's default) that ran to hours; this keeps a full
                         run practical. Step 6 is a manual command, not a CI gate, so
                         this trades local CPU for wall-clock and nothing else. -->
                    <threads>4</threads>
                    <outputFormats>
                        <param>HTML</param>
                    </outputFormats>
                    <!-- Added for #196: measured baseline on develop, fresh run against the
                         full targetClasses/excludedClasses lists above -
                         1088/2115 mutations killed (51%), 17m9s, 259 tests. Was purely
                         advisory before this; now `mvn org.pitest:pitest-maven:mutationCoverage`
                         fails below this. Ratcheted by .claude/tools/check-quality-gates.sh -
                         see specs/features/pit-mutation-threshold.feature. -->
                    <mutationThreshold>51</mutationThreshold>
                </configuration>
            </plugin>
            <!-- Step 4 code-quality gates: PMD enforces cyclomatic complexity, function
                 length, parameter count, and duplicate-code detection via rulesets/java/design.xml.
                 Bound to verify. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>cpd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cpd-check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failOnViolation>${pmd.failOnViolation}</failOnViolation>
                    <linkXRef>false</linkXRef>
                    <includeTests>false</includeTests>
                    <minimumTokens>100</minimumTokens>
                    <!-- Minimal ruleset: ONLY complexity, method length, parameters, and CPD -->
                    <rulesets>
                        <ruleset>${project.basedir}/.pmd-minimal.xml</ruleset>
                    </rulesets>
                    <!-- Exclude pure layout classes from PMD checks -->
                    <excludes>
                        <exclude>**/ui/widget/ButtonWidget.java</exclude>
                        <exclude>**/ui/widget/FocusManager.java</exclude>
                        <exclude>**/ui/widget/TerminalScrollBarUI.java</exclude>
                        <exclude>**/ui/widget/Widget.java</exclude>
                        <exclude>**/ui/GameWindow.java</exclude>
                        <exclude>**/ui/ResetConfirmationPopup.java</exclude>
                        <exclude>**/ui/SettingsWindow.java</exclude>
                        <exclude>**/GameConst.java</exclude>
                        <exclude>**/Positionable.java</exclude>
                        <exclude>**/DrawableAsciiEntity.java</exclude>
                        <exclude>**/exceptions/ModLoadException.java</exclude>
                        <exclude>**/game/GameListener.java</exclude>
                        <exclude>**/sandbox/ClassSandbox.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Step 4 bytecode-dataflow gate: SpotBugs + fb-contrib for defects that
                 require dataflow analysis (EI_EXPOSE_REP, equals/hashCode contract,
                 null-deref paths, non-transient Serializable fields, ignored returns,
                 self-assignment, unrelated-type comparison, plus 100s of fb-contrib
                 heuristics). Bound to clean-code profile only (not verify): measured
                 at ~33s for `spotbugs:spotbugs` alone at Max effort against this
                 codebase, against a ~38s baseline `mvn verify` - binding it to verify
                 would very nearly double inner-loop time, so it is diff-scoped through
                 check-clean.sh instead, the same reasoning as .pmd-clean-code.xml's
                 profile placement above. Find Security Bugs is NOT loaded - Veil is
                 offline single-player with no network surface. -->
            <!-- Step 4 coverage gate: JaCoCo enforces 85% line coverage repo-wide.
                 Bound to verify. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Class-file globs excluded from the coverage ratio below. This must
                                 live here (the check goal's own top-level excludes), not as
                                 <rule><excludes> with dotted FQNs — that form is silently a no-op
                                 for an element=BUNDLE rule (verified: with only the FQN list, the
                                 check still failed at raw ~81% instead of the ~86% the exclusions
                                 should have produced). -->
                            <!-- Every entry below also carries a `$*` sibling glob (added for
                                 #196): the bare glob only matches the outer class's own compiled
                                 file, not its nested/anonymous inner classes, which JaCoCo still
                                 reports as separate SOURCEFILE-relevant rows otherwise - verified
                                 by ButtonWidget and InventoryPanel, both of which carry anonymous
                                 AbstractAction inner classes the bare glob missed. -->
                            <excludes>
                                <exclude>**/ui/widget/ButtonWidget.class</exclude>
                                <exclude>**/ui/widget/ButtonWidget$*.class</exclude>
                                <exclude>**/ui/widget/FocusManager.class</exclude>
                                <exclude>**/ui/widget/FocusManager$*.class</exclude>
                                <exclude>**/ui/widget/TerminalScrollBarUI.class</exclude>
                                <exclude>**/ui/widget/TerminalScrollBarUI$*.class</exclude>
                                <exclude>**/ui/widget/Widget.class</exclude>
                                <exclude>**/ui/widget/Widget$*.class</exclude>
                                <exclude>**/ui/GameWindow.class</exclude>
                                <exclude>**/ui/GameWindow$*.class</exclude>
                                <exclude>**/ui/InventoryPanel.class</exclude>
                                <exclude>**/ui/InventoryPanel$*.class</exclude>
                                <exclude>**/ui/ResetConfirmationPopup.class</exclude>
                                <exclude>**/ui/ResetConfirmationPopup$*.class</exclude>
                                <exclude>**/ui/SettingsWindow.class</exclude>
                                <exclude>**/ui/SettingsWindow$*.class</exclude>
                                <exclude>**/Main.class</exclude>
                                <exclude>**/Main$*.class</exclude>
                                <exclude>**/GameConst.class</exclude>
                                <exclude>**/GameConst$*.class</exclude>
                                <exclude>**/Positionable.class</exclude>
                                <exclude>**/Positionable$*.class</exclude>
                                <exclude>**/DrawableAsciiEntity.class</exclude>
                                <exclude>**/DrawableAsciiEntity$*.class</exclude>
                                <exclude>**/exceptions/ModLoadException.class</exclude>
                                <exclude>**/exceptions/ModLoadException$*.class</exclude>
                                <exclude>**/game/GameListener.class</exclude>
                                <exclude>**/game/GameListener$*.class</exclude>
                                <exclude>**/sandbox/ClassSandbox.class</exclude>
                                <exclude>**/sandbox/ClassSandbox$*.class</exclude>
                                <!-- Added for #196: pure data record (label/value pair), no
                                     branching logic to cover. -->
                                <exclude>**/component/DetailField.class</exclude>
                                <exclude>**/component/DetailField$*.class</exclude>
                                <!-- Added for #196: pure data record grouping three panels, no
                                     branching logic to cover. -->
                                <exclude>**/ui/PopupPanels.class</exclude>
                                <exclude>**/ui/PopupPanels$*.class</exclude>
                                <!-- Added for #196: pure JLayeredPane assembly, same category as
                                     GameWindow/SettingsWindow above - no branching logic. -->
                                <exclude>**/ui/SettingsKeybindsWindow.class</exclude>
                                <exclude>**/ui/SettingsKeybindsWindow$*.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                        <!-- Added for #196: measured baseline 78.98% (819/1037) on
                                             develop. Closes the hole where line coverage alone
                                             can't tell a fully-branched `if` from one that only
                                             ever took its true path. -->
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.78</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Added for #196: catches a brand-new file shipping at 0%
                                     coverage, which the BUNDLE ratio above can hide behind the
                                     existing corpus. element=SOURCEFILE, not CLASS: CLASS counts
                                     every compiled .class file, including anonymous/nested inner
                                     classes - measured on develop, the worst such rows are
                                     incidental helpers of already-tested widgets, forcing any
                                     green CLASS floor down to ~0% (a gate that catches nothing).
                                     SOURCEFILE judges the .java file someone actually adds, with
                                     no per-inner-class exclusion list to maintain. Full derivation:
                                     specs/intent/coverage-gate-floors-class-scope.md. -->
                                <rule>
                                    <element>SOURCEFILE</element>
                                    <limits>
                                        <!-- Measured baseline: FillLayout.java, 35.7% (5/14). -->
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.35</minimum>
                                        </limit>
                                        <!-- Measured baseline: FillLayout.java, 50.0% (3/6) - also
                                             the exact score of TitleScreenPanel.java and
                                             ClassSandboxProvider.java. The floor sits AT the
                                             measured worst, deliberately (JaCoCo's check is >=),
                                             not below it - do not add headroom. -->
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.50</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Clean Code gate (Uncle Bob rules), driven by
             `.claude/tools/check-clean.sh`. Deliberately a profile and NOT an
             execution bound to a lifecycle phase: these rules are not green
             across the existing codebase, so binding them to `verify` would
             turn `develop` red on the day they landed. The script scopes them
             to the files a change actually touched instead.

             Invoked as: mvn -P clean-code pmd:pmd pmd:cpd
             Reports land in target/clean-code/ so they never clobber the
             repo-wide reports written by the `verify`-bound executions above. -->
        <profile>
            <id>clean-code</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pmd-plugin</artifactId>
                        <configuration>
                            <rulesets combine.self="override">
                                <ruleset>${project.basedir}/.pmd-clean-code.xml</ruleset>
                            </rulesets>
                            <!-- Test-quality rules need the test sources. The
                                 script routes rules to main/test by path. -->
                            <includeTests>true</includeTests>
                            <!-- The layout-class exclusions on the repo-wide
                                 gate exist because those files have long
                                 methods. They are not exempt from naming, dead
                                 code or error-handling rules, and a diff-scoped
                                 run only looks at them if you edited them. -->
                            <excludes combine.self="override"/>
                            <format>xml</format>
                            <targetDirectory>${project.build.directory}/clean-code</targetDirectory>
                            <!-- Tighter than the repo-wide 100: a fresh block
                                 of 50 duplicated tokens is a copy-paste, not
                                 incidental similarity. -->
                            <minimumTokens>50</minimumTokens>
                            <skipEmptyReport>false</skipEmptyReport>
                            <failOnViolation>false</failOnViolation>
                        </configuration>
                    </plugin>
                    <!-- SpotBugs in the clean-code profile: generates XML report for
                         diff-scoped analysis by check-clean.sh. Uses Max effort for
                         maximum precision, writes to target/clean-code/spotbugs.xml,
                         and does not fail the build (check-clean.sh does the diff-
                         scoping and decides pass/fail).
                         Version 4.10.4.1 bundles ASM recent enough to parse runtime
                         bytecode from JDK 24 (major version 68), needed because Maven
                         runs on the machine's JDK (which may be newer than the
                         project's Java 17 compile target) - earlier SpotBugs versions
                         bundled older ASM that rejected modern JDK bytecode.
                         Threshold=Medium, not High: measured against this codebase,
                         High reports 32 findings and misses EI_EXPOSE_REP/EI_EXPOSE_REP2
                         entirely (0 of the 75 existing instances surface) - the exact
                         defect class this gate exists to catch. Medium reports 269
                         (236 unique) and includes all 75. Low adds only lower-precision
                         noise (S508C_*, FII_USE_FUNCTION_IDENTITY, etc.) on top of
                         Medium - EI_EXPOSE_REP/REP2 counts are identical between Medium
                         and Low (39/36 either way), so Low buys nothing. Medium is the
                         smallest threshold that still reports every blocking rule
                         check-clean.sh relies on. -->
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.10.4.1</version>
                        <executions>
                            <execution>
                                <id>spotbugs-report</id>
                                <goals>
                                    <goal>spotbugs</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Medium</threshold>
                            <excludeFilterFile>${project.basedir}/.spotbugs-exclude.xml</excludeFilterFile>
                            <spotbugsXmlOutputDirectory>${project.build.directory}/clean-code</spotbugsXmlOutputDirectory>
                            <spotbugsXmlOutputFilename>spotbugs.xml</spotbugsXmlOutputFilename>
                            <failOnError>false</failOnError>
                            <plugins>
                                <plugin>
                                    <groupId>com.mebigfatguy.fb-contrib</groupId>
                                    <artifactId>fb-contrib</artifactId>
                                    <version>7.7.4</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
