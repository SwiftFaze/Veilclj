;; Layer direction for dependency-checker (docs/architecture.md).
;; Components are the second namespace segment: veil.main -> :main,
;; veil.ui.* -> :ui, veil.game.* -> :game, veil.mods.* -> :mods.
;; Dependencies point downward only.
{:allowed-dependencies {:main [:ui :game :mods]
                        :ui   [:game]
                        :game []
                        :mods []}
 :fail-on-violations true
 :fail-on-cycles     true}
